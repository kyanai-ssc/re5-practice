{
    "license": "",
    "name": "kuchen/validation",
    "authors": [],
    "require": {
        "php": ">= 7.4",
        "cakephp/cakephp": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpmd/phpmd": "^2.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Kuchen\\Validation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kuchen\\Validation\\Test\\": "tests"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=PSR12 ./src ./tests",
        "phpcbf": "phpcbf --standard=PSR12 ./src ./tests",
        "phpmd": "phpmd src text phpmd.xml",
        "phpstan": "phpstan analyze -c phpstan.neon -l max --memory-limit=-1 src",
        "test": "phpunit",
        "code-check": [
            "@phpcs",
            "@phpmd",
            "@phpstan"
        ],
        "check": [
            "@code-check",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
